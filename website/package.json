{
  "name": "mastercad-company-profile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "check": "tsc --noEmit",
    "setup": "tsx scripts/setup.ts",
    "admin:create": "tsx scripts/admin.ts",
    "test": "tsx --test tests/backend.test.ts",
    "backup": "tsx scripts/maintenance.ts backup",
    "purge": "tsx scripts/maintenance.ts purge",
    "format": "prettier --write src scripts tests next.config.mjs tsconfig.json package.json"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
